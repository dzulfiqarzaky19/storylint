# Committed, non-secret local-dev defaults. Loaded by Next.js for all
# environments; overridden by the gitignored .env.local (secrets live there).
#
# Web search (F10): point the research chat at the SearXNG service that
# `docker compose up` starts (see docker-compose.yml). Ready to use with no
# manual setup. Unset this to disable web search (wiki-only, no network egress).
WEBSEARCH_SEARXNG_URL=http://localhost:8888
