# Committed, non-secret e2e config. Loaded ONLY by the e2e runner (playwright
# config + global-setup), never by `next dev`. Points every e2e process — the
# db:reset/db:seed scripts AND the `next start -p 3100` server the specs drive —
# at the ISOLATED test database (docker-compose service `db_test`, port 5435,
# database `ashkeld_test`, its own volume). This is why `playwright test` can
# reset+seed freely without ever touching the live dev DB on :5434/ashkeld.
DATABASE_URL=postgresql://ashkeld:ashkeld@localhost:5435/ashkeld_test
