# Any OpenAI-compatible endpoint: 9-router, LM Studio, Ollama, OpenRouter, LiteLLM, etc.
LLM_PROVIDER=9-router
LLM_MODEL=
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
LLM_MAX_TOKENS=20000

# 1 forces deterministic fixture mode; 0 uses live mode when all LLM settings exist.
STORYLINT_FIXTURE_LLM=0
