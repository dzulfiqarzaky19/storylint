{
  "name": "ashkeld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e:clean": "node tests/e2e/clean.mjs",
    "db:reset": "tsx src/lib/db/reset.ts",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset-research": "tsx src/lib/db/reset-research.ts",
    "db:setup": "npm run db:reset && npm run db:seed"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@tiptap/core": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "defuddle": "^0.19.2",
    "drizzle-orm": "^0.45.2",
    "linkedom": "^0.18.13",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4",
    "typescript": "^5.9",
    "vitest": "^4.1.10"
  }
}
