{
  "name": "storylint",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types src/server/index.ts",
    "build": "tsc -b && vite build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:e2e": "node e2e/all-smoke.mjs",
    "ux:shell": "node e2e/ux-drive.mjs",
    "ux:graph": "node e2e/ux-drive-graph.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "calm": "node e2e/calm-budget.mjs"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
