node_modules
# Next.js build output: default `.next` plus isolated build dirs used by
# parallel dev/e2e servers (.next-e2e, .next-verify) and stale snapshots
# (.next.stale-*). None of these are ever pushed.
.next*
out
build

data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

.env
.env*.local

*.tsbuildinfo
next-env.d.ts

test-results
playwright-report

# db:reset-research writes timestamped JSON dumps here before wiping the four
# research tables. Local recovery artifacts, never source, never pushed.
backups/

# local-only, not pushed to dev2
.claude/
# Agent operating contract + swarm routing config: local-only per-clone setup,
# same zone as .claude/. Kept out of git so a branch switch can't lose them and
# an un-scoped `git add` can't sweep them into a commit.
/AGENTS.md
/.jcode/
docs/
/Fiction writing app redesign/
*.log
tasks/

# Scratch/probe files at repo root (agent throwaways: _dump.cjs, _engine.mts,
# _srv2.log, verification output). Never source, never pushed.
/_*
